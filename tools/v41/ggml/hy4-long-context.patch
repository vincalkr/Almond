+// Almond: ggml_get_rows with the result's type chosen (the CUDA/HIP kernel writes F16 and BF16 as well)
+struct ggml_tensor * ggml_get_rows_type(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        enum ggml_type        type) {
+    struct ggml_tensor * result = ggml_get_rows(ctx, a, b);
+    if (type != result->type) {
+        struct ggml_tensor * r = ggml_new_tensor_4d(ctx, type, result->ne[0], result->ne[1], result->ne[2], result->ne[3]);
+        r->op     = GGML_OP_GET_ROWS;
+        r->src[0] = a;
+        r->src[1] = b;
+        return r;
+    }
+    return result;
