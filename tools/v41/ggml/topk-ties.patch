+
+// one block per row: the first state->rank columns whose key equals the k-th, lowest column first, so ties are broken
+// the same way on every run
+template<int BLOCK_SIZE>
+static __global__ void top_k_radix_ties(
+        const float * __restrict__ src,
+        int * __restrict__ dst,
+        const top_k_radix_state * __restrict__ states,
+        int ncols,
+        int k) {
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+    const float * row_src = src + (size_t) row * ncols;
+    int * row_dst = dst + (size_t) row * k;
+    const uint32_t prefix = states[row].prefix;
+    const int rank = states[row].rank;
+    __shared__ int warp_counts[BLOCK_SIZE / 32 + 1];
+    int taken = 0;
+    for (int base = 0; base < ncols && taken < rank; base += BLOCK_SIZE) {
+        const int col = base + tid;
+        const bool eq = col < ncols && top_k_float_to_ordered(row_src[col]) == prefix;
+        // block-wide exclusive prefix count of eq, in thread (column) order
+        const int lane = tid % 32, warp = tid / 32;
+        int incl = eq ? 1 : 0;
+        for (int off = 1; off < 32; off <<= 1) {
+            const int v = __shfl_up_sync(0xffffffff, incl, off, 32);
+            if (lane >= off) incl += v;
+        }
+        if (lane == 31) warp_counts[warp] = incl;
+        __syncthreads();
+        if (tid == 0) {
+            int acc = 0;
+            for (int w = 0; w < BLOCK_SIZE / 32; ++w) { const int c = warp_counts[w]; warp_counts[w] = acc; acc += c; }
+            warp_counts[BLOCK_SIZE / 32] = acc;
+        }
+        __syncthreads();
+        const int pos = taken + warp_counts[warp] + incl - (eq ? 1 : 0);
+        if (eq && pos < rank) row_dst[k - rank + pos] = col;
+        taken += warp_counts[BLOCK_SIZE / 32];
+        __syncthreads();
     }
 }
 
