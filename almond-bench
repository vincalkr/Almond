#!/bin/sh
# almond-bench - quality benchmarks for the local models and their quantizations (tools/bench/)
#   ./almond-bench [--url URL]                  the interface (Textual), against the router on 127.0.0.1:8150
#   ./almond-bench fetch [--update] [SUITE...]  download the missing datasets (--update: newer revisions; --list)
#   ./almond-bench run --model M [--preset quick|full] [--suites a,b] [--reasoning LEVEL] [--judge-model J] [--resume FILE]
#   ./almond-bench kld REF.f32 CAND.f32 --vocab V --name Q [--ref-name R]   KL divergence from logit dumps
R=$(cd "$(dirname "$0")" && pwd) || exit 1
PY=${ALMOND_PY:-$R/.venv/bin/python}
[ -x "$PY" ] || PY=python3
case "$1" in
    -h|--help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
    fetch) shift; exec "$PY" "$R/tools/bench/datasets.py" "$@" ;;
    run) shift; exec "$PY" "$R/tools/bench/bench_core.py" "$@" ;;
    kld) shift; exec "$PY" "$R/tools/bench/kld.py" "$@" ;;
esac
"$PY" -c "import textual" 2>/dev/null || { echo "almond-bench: the interface needs textual ($PY -m pip install textual); 'run' works without it" >&2; exit 1; }
exec "$PY" "$R/tools/bench/bench_ui.py" "$@"
